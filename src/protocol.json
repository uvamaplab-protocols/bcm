{
  "home": {
    "title": "BCM",
    "element": {
      "type": "list",
      "elements": [
        {
          "type": "alert",
          "title": "MyMedSupport!",
          "message": "Your personalized partner",
          "icon": {
            "url": "/assets/diagnosis.png",
            "tint": false
          }
        },
        {
          "type": "devices",
          "summary": [
            {
              "device_id": "device_1",
              "text": "WisePill",
              "icon": {
                "url": "/assets/wisepill.png"
              }
            }
          ]
        },
        {
          "type": "survey",
          "action": {
            "text": "Surveys",
            "action": "navmodal://Survey"
          }
        },
        {
          "type": "reports",
          "title": "Your routine",
          "icon": {
            "url": "/assets/adherence.png",
            "tint": false
          },
          "text": "View Routine",
          "reports": [
            {
              "title": "Set your daily routine",
              "action": "flow://flows/adherance/routine",
              "report": true
            }
          ]
        },
        {
          "type": "reports",
          "title": "Your social support",
          "icon": {
            "url": "/assets/hands.png",
            "tint": false
          },
          "text": "View support",
          "reports": [
            {
              "title": "Learn how to set your social support",
              "action": "flow://flows/support"
            },
            {
              "title": "${global:person1name,Person 1}",
              "action": "flow://flows/persons/person1",
              "report": true
            },
            {
              "title": "${global:person2name,Person 2}",
              "action": "flow://flows/persons/person2",
              "report": true
            },
            {
              "title": "${global:person3name,Person 3}",
              "action": "flow://flows/persons/person3",
              "report": true
            }
          ]
        },
        {
          "type": "tiles",
          "title": "More resources",
          "icon": {
            "url": "/assets/document.png",
            "tint": false
          },
          "actions": [
            {
              "text": "To About Your Medicines",
              "action": "flow://flows/medication",
              "backgroundcolor": "#1A5C2FDA",
              "markcompleted": true
            },
            {
              "text": "To Tips for taking your medicine",
              "backgroundcolor": "#1A00C2FF",
              "action": "flow://flows/adherance"
            },
            {
              "text": "To Managing Your Symptoms",
              "backgroundcolor": "#1A00E05A",
              "action": "flow://flows/symptom"
            },
            {
              "text": "Your Healthcare Team",
              "backgroundcolor": "#1A206AFF",
              "action": "navpage://Contact"
            }
          ]
        }
      ]
    }
  },
  "surveys": {
    "routine": {
      "type": "sequential",
      "trigger_flow_path": "flow://flows/adherance/routine",
      "path": "flow://flows/adherance/routine check in",
      "period": "00:02:00"
    }
  },
  "devices": {
    "device_1": {
      "type": "WisePill",
      "connect_title": "Enter imei number",
      "connect_description": "Enter imei number of your WisePill box to connect. This will allow us to track when you take your medication and send you reminders if you forget."
    }
  },
  "goals": {
    "goal_1": {
      "device_id": "device_1",
      "data_type": "delta-read",
      "type": "percentage",
      "field": "event",
      "required_days": 7,
      "target_value": 1
    }
  }
}
